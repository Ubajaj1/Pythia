# Copy this file to .env and fill in one provider's key.
# Pythia auto-detects: Anthropic → Groq → OpenAI → Ollama (in that order).

# --- Option 1: Groq (recommended — free tier, fast) ---
# Sign up at https://console.groq.com → API Keys → Create key
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b        (main)
# GROQ_FAST_MODEL=openai/gpt-oss-20b    (per-agent turns)
# Or set any role explicitly as provider:model:
# PYTHIA_MAIN_MODEL=openai:gpt-4.1-mini
# PYTHIA_TICK_MODEL=openai:gpt-4.1-nano

# --- Option 2: Anthropic ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5          (analysis, generation, summaries)
# ANTHROPIC_TICK_MODEL=claude-haiku-4-5    (per-agent turns)
# Anthropic rate limit (requests per minute). Tier 1 Haiku = 50 RPM;
# default 40 leaves a safety margin. Raise to ~800 on Tier 2, higher on Tier 3+.
# ANTHROPIC_RPM=40

# --- Option 3: OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Option 4: Ollama (local, no API key) ---
# Run with: docker compose --profile ollama up
# Then pull a model: docker compose exec ollama ollama pull llama3.1:8b
# OLLAMA_BASE_URL=http://ollama:11434  (set automatically in Docker)
